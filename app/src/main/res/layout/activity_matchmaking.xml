<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬"
        android:textSize="64sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Random Chat"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <!-- Dynamic status message -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press the button to find someone to chat with!"
        android:textSize="14sp"
        android:textColor="#AAAACC"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <!-- Loading spinner shown while searching -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:indeterminateTint="#4A90D9"
        android:layout_marginBottom="24dp"/>

    <!-- Find chat button -->
    <Button
        android:id="@+id/findChatButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="🔍 Find Someone"
        android:backgroundTint="#4A90D9"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Logout button -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="#555555"
        android:textColor="#FFFFFF"
        android:padding="12dp"/>

</LinearLayout>
