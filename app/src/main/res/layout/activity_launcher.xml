<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LauncherActivity">


      <ImageView
        android:id="@+id/logo_id"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/ic_comrst_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMRST"
        android:id="@+id/app_name_id"
        android:fontFamily="sans-serif-medium"
        android:textSize="32sp"
        android:letterSpacing="0.08"
        app:layout_constraintEnd_toEndOf="@+id/logo_id"
        app:layout_constraintStart_toStartOf="@+id/logo_id"
        app:layout_constraintTop_toBottomOf="@+id/logo_id"
        android:alpha="0"/>

    <TextView
        android:id="@+id/tag_name_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meet. Chat. Move On."
        android:textColor="#64748B"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/app_name_id"
        app:layout_constraintStart_toStartOf="@+id/app_name_id"
        app:layout_constraintTop_toBottomOf="@+id/app_name_id"
        android:alpha="0"/>

</androidx.constraintlayout.widget.ConstraintLayout>